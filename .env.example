TELEGRAM_BOT_TOKEN=your_token_here
# Local Bot API server — a telegram-bot-api container that runs on its own host, not with this
# bot. This is the name production really passes (and the name the rest of the park's bots
# use); the old TELEGRAM_API_SERVER is still accepted as a fallback so an existing .env keeps
# working — see the comment on the field in src/settings.py.
# The value below is a PLACEHOLDER: put the real address in the stack's environment, not in a
# file that lives in a public repository. The scheme is not optional — src/settings.py refuses
# a bare host:port, because the library error that a schemeless URL produces quotes the whole
# request URL, and a request URL carries the bot token.
# TELEGRAM_BOT_API_SERVER=http://bot-api.example.lan:8081
DATABASE_PATH=data/health.db
DEFAULT_TIMEZONE=+03:00
LOG_LEVEL=INFO
# Where the liveness mark the healthcheck reads is written. Defaults to `heartbeat` next to
# DATABASE_PATH; set it only to point the probe somewhere else, as the CI smoke gate does.
# HEARTBEAT_FILE=data/heartbeat
