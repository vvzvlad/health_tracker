TELEGRAM_BOT_TOKEN=your_token_here
# Local Bot API server. This is the name production really passes (and the name the rest of
# the park's bots use); the old TELEGRAM_API_SERVER is still accepted as a fallback so an
# existing .env keeps working — see the comment on the field in src/settings.py.
# TELEGRAM_BOT_API_SERVER=http://10.31.41.70:8081
DATABASE_PATH=data/health.db
DEFAULT_TIMEZONE=+03:00
LOG_LEVEL=INFO
# Where the liveness mark the healthcheck reads is written. Defaults to `heartbeat` next to
# DATABASE_PATH; set it only to point the probe somewhere else, as the CI smoke gate does.
# HEARTBEAT_FILE=data/heartbeat
